[Unit]
Description=Mac-style Magic Trackpad (three-finger drag, momentum, gestures)
# Owns the real touchpad for its whole lifetime (exclusive grab + clone);
# if it dies the touchpad has no reader, so restart promptly. Touchpad
# re-enumeration is handled in-process; Restart= is the backstop.
# Started at login and by 99-mac-trackpad.rules whenever a touchpad
# appears (Bluetooth reconnect), never by polling.

[Service]
Type=exec
ExecStart=%h/.local/bin/mac-trackpad
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
